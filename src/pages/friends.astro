---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import PageTitle from "@/components/layout/PageTitle.astro";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
  return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
  throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
  commentConfig?.type &&
  commentConfig.type !== "none" &&
  friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
  friendsPageConfig.description || i18n(I18nKey.friendsDescription);

const pad = (value: number) => String(value).padStart(2, "0");
const getHost = (url: string) =>
  url.replace(/^https?:\/\//, "").split("/")[0];
---

<MainGridLayout title={title} description={description} hideSidebars={true}>
  <div class="ip ip-friends">
  <div class="friends-intro">
    <PageTitle
      eyebrow="FRIENDS"
      title={title}
      desc={description}
      icon="material-symbols:group"
      meta={[`${items.length} 个站点`]}
    />
  </div>

  {
    items.length > 0 ? (
      <section class="friends-grid" aria-label="友链列表">
        {items.map((item, index) => (
          <a
            class="friend-stop"
            href={item.siteurl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <figure class="friend-stop__cover">
              <img
                src={item.cover || item.imgurl}
                alt={`${item.title} 封面`}
                loading="lazy"
                decoding="async"
              />
            </figure>

            <div class="friend-stop__body">
              <div class="friend-stop__meta">
                <span>NO.{pad(index + 1)}</span>
                <span>{getHost(item.siteurl)}</span>
              </div>

              <h2 class="friend-stop__title">{item.title}</h2>
              <p class="friend-stop__desc">{item.desc}</p>

              {item.tags && item.tags.length > 0 ? (
                <div class="friend-stop__tags">
                  {item.tags.slice(0, 3).map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              ) : null}

              <span class="friend-stop__cta">
                访问站点
                <Icon name="material-symbols:arrow-outward-rounded" />
              </span>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <div class="friends-empty">
        还没有添加友链，去 <code>src/config/friendsConfig.ts</code> 里填写吧。
      </div>
    )
  }

  {friendsPageConfig.showCustomContent !== false && (
    <div class="mt-4 relative z-10 w-full">
      <Markdown class="">
        <Content />
      </Markdown>
    </div>
  )}

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={friendsPost} customPath="/friends/" />
    </div>
  )}
  </div>
</MainGridLayout>
