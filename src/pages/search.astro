---
import AdvancedSearch from "@components/pages/AdvancedSearch.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageTitle from "@/components/layout/PageTitle.astro";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const title = i18n(I18nKey.search);
const description = "";

// 检索页自己的栏宽（46rem）：与归档页同机制（外层满宽，这里限宽居中），
// 面板高度随内容走 —— 不再垫一块撑满 80vh 的大黑卡
const posts = await getSortedPostsList();
const examples = posts.slice(0, 4).map((post) => post.data.title);
---

<MainGridLayout title={title} description={description} hideSidebars={true}>
    <div class="ip ip-search-page">
        <PageTitle
            eyebrow="Search"
            title={title}
            icon="material-symbols:search-rounded"
            meta={[`${posts.length} ${i18n(I18nKey.postsCount)}`]}
        />
        <div class="card-base ip-search-sheet px-6 py-6 md:px-9 md:py-8">
            <AdvancedSearch client:load examples={examples} />
        </div>
    </div>
</MainGridLayout>

{import.meta.env.PROD && (
<script is:inline define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}>
    if (!window.pagefind) {
        async function loadPagefind() {
            const url = scriptUrl.replace(/\/$/, "")
            try {
                const response = await fetch(url, { method: 'HEAD' });
                if (response.status !== 200) {
                    return;
                }
                const pagefind = await import(scriptUrl);
                await pagefind.options({
                    "excerptLength": 20
                });
                window.pagefind = pagefind;
                window.dispatchEvent(new Event('pagefindready'));
            } catch (error) {
                console.warn("Pagefind script not found or failed to load.");
                window.dispatchEvent(new Event('pagefindloaderror'));
            }
        }
        loadPagefind();
    }
</script>
)}
