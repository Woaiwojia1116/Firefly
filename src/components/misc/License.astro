---
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	title: string;
	id: string;
	pubDate: Date;
	class: string;
	author: string;
	sourceLink: string;
	licenseName: string;
	licenseUrl: string;
}

const { pubDate, author, licenseName, licenseUrl } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const licenseConf = licenseConfig;
---

{/* 落款式版权行：作者 · 发布于 · 许可，无底色无框，与正文融为一体 */}
<div class={`ip-post-license ${className}`}>
  <span class="ip-post-license__item">
    {i18n(I18nKey.author)}
    <b>{author || profileConf.name}</b>
  </span>
  <span class="ip-post-license__dot" aria-hidden="true">·</span>
  <span class="ip-post-license__item">
    {i18n(I18nKey.publishedAt)}
    <b>{formatDateToYYYYMMDD(pubDate)}</b>
  </span>
  <span class="ip-post-license__dot" aria-hidden="true">·</span>
  <a
    href={licenseName ? licenseUrl || undefined : licenseConf.url}
    target="_blank"
    rel="noopener"
    class="ip-post-license__link"
  >
    {licenseName || licenseConf.name}
  </a>
</div>
