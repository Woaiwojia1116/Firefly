---
/**
 * 全站模拟雨丝特效
 * 固定铺满视口的 canvas，压在全站夜色背景（z-index: 1）之上、内容主体（z-30）之下，
 * pointer-events: none，不拦截任何交互。
 * 配置见 src/config/backgroundWallpaper.ts 的 rain 字段。
 */
import { backgroundWallpaper } from "@/config";

const rainConfig = backgroundWallpaper.rain;
---

{rainConfig?.enable && (
	<canvas
		id="rain-canvas"
		class:list={["rain-canvas", { "rain-canvas--no-home": !rainConfig.showOnHomepage }]}
		aria-hidden="true"
	>
	</canvas>

	<script is:inline define:vars={{ rainConfig }}>
		(function () {
			var canvas = document.getElementById("rain-canvas");
			if (!canvas) return;

			var ctx = canvas.getContext("2d");
			if (!ctx) return;

			// 用户偏好减少动态效果时不播放
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

			var config = rainConfig;
			var density = Math.min(Math.max(config.density ?? 1, 0.2), 3);
			var baseAngle = ((config.angle ?? 12) * Math.PI) / 180;
			var color = config.color || "188, 212, 240";
			// 移动端降级：数量减半（enableOnMobile 为 false 时数量再折半并降低不透明度）
			var isMobile = window.matchMedia("(max-width: 767px)").matches;
			if (isMobile && !config.enableOnMobile) density *= 0.5;

			var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			var drops = [];
			var running = true;
			var lastTime = performance.now();

			function dropCount() {
				// 按屏幕面积估算数量：1920x1080 下约 150 条
				var n = Math.round(((window.innerWidth * window.innerHeight) / 14000) * density);
				return Math.min(Math.max(n, 20), 500);
			}

			function spawn(drop, initial) {
				var angle = baseAngle + (Math.random() - 0.5) * 0.14; // 每条雨丝带一点角度抖动
				var speed = 700 + Math.random() * 700; // px/s
				drop.angle = angle;
				drop.speed = speed;
				drop.len = (12 + Math.random() * 16) * (isMobile ? 0.8 : 1);
				drop.alpha = 0.08 + Math.random() * 0.3;
				drop.width = 0.6 + Math.random() * 0.9;
				drop.x = Math.random() * (window.innerWidth + 200) - 100;
				drop.y = initial
					? Math.random() * window.innerHeight
					: -drop.len - Math.random() * 80;
				drop.vx = Math.sin(angle) * speed;
				drop.vy = Math.cos(angle) * speed;
			}

			function resize() {
				dpr = Math.min(window.devicePixelRatio || 1, 1.5);
				canvas.width = window.innerWidth * dpr;
				canvas.height = window.innerHeight * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				var count = dropCount();
				drops = [];
				for (var i = 0; i < count; i++) {
					var d = {};
					spawn(d, true);
					drops.push(d);
				}
			}

			function frame(now) {
				requestAnimationFrame(frame);
				if (!running) return;

				// 配置为不在首页显示时，首页直接跳过绘制（节点常驻，Swup 切页无需重建）
				var hiddenOnHome = canvas.classList.contains("rain-canvas--no-home") &&
					document.body.classList.contains("homepage");
				var dt = Math.min((now - lastTime) / 1000, 0.05);
				lastTime = now;
				if (hiddenOnHome) return;

				var w = window.innerWidth;
				var h = window.innerHeight;
				ctx.clearRect(0, 0, w, h);
				ctx.lineCap = "round";

				for (var i = 0; i < drops.length; i++) {
					var d = drops[i];
					d.x += d.vx * dt;
					d.y += d.vy * dt;
					if (d.y > h + d.len || d.x < -150 || d.x > w + 150) {
						spawn(d, false);
						continue;
					}
					ctx.globalAlpha = d.alpha;
					ctx.strokeStyle = "rgb(" + color + ")";
					ctx.lineWidth = d.width;
					ctx.beginPath();
					ctx.moveTo(d.x, d.y);
					ctx.lineTo(d.x - Math.sin(d.angle) * d.len, d.y - Math.cos(d.angle) * d.len);
					ctx.stroke();
				}
				ctx.globalAlpha = 1;
			}

			var resizeTimer;
			window.addEventListener("resize", function () {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(resize, 200);
			});

			// 标签页不可见时暂停，回来时重置时间戳避免雨丝瞬移
			document.addEventListener("visibilitychange", function () {
				if (document.hidden) {
					running = false;
				} else {
					lastTime = performance.now();
					running = true;
				}
			});

			resize();
			requestAnimationFrame(frame);
		})();
	</script>

	<style>
		.rain-canvas {
			position: fixed;
			inset: 0;
			z-index: 2; /* 夜色背景(1)之上、内容主体(z-30)之下 */
			width: 100%;
			height: 100%;
			pointer-events: none;
		}
		/* 首页有自己的画布背景，默认跟随夜色背景在首页隐藏 */
		.rain-canvas--no-home {
			/* 由脚本根据 body.homepage 跳过绘制，CSS 只做兜底 */
		}
		body.homepage .rain-canvas--no-home {
			display: none;
		}
	</style>
)}
