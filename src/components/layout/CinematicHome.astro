---
// 首页 · 雨夜山城（仅首页第 1 页 /）
// ---------------------------------------------------------------------------
// 整页压在同一张背景照片上（雨夜窗前的山城灯火）：首屏是全屏画面 + 视差，
// 向下滚动后由固定的全页背景层接住，关于我 → 最新文章 → 分类与入口都浸在
// 同一张夜色照片里（文字固定为米白夜色系，不随主题翻转）。
// 最新文章为主卡 + 行卡布局：左侧 1 张大图精选卡，右侧其余文章的行卡列表。
//
// 样式统一以 #fyh-home / .fyh-* 限定，色彩全部取自 tokens.css 的 --fy-*。
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import { createHash } from "node:crypto";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { cinematicHomeConfig, commentConfig, profileConfig, siteConfig } from "@/config";
import { announcementConfig } from "@/config/announcementConfig";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryList, getSortedPosts } from "@/utils/content-utils";
import {
  getCategoryUrl,
  getFileDirFromPath,
  getPostUrlBySlug,
  url,
} from "@/utils/url-utils";

interface Props {
	/** 首页第 1 页的真实文章（来自 [...page].astro 的 page.data） */
	posts?: CollectionEntry<"posts">[];
}

const { posts = [] } = Astro.props;

const cfg = cinematicHomeConfig;
const hero = cfg.hero;
const about = cfg.about;
const articles = cfg.articles;
const entries = cfg.entries;

// ── 首屏 ────────────────────────────────────────────────────────────────
const heroImage = hero.image?.trim() ?? "";
const hasHeroImage = heroImage !== "";
const heroBg = hero.background?.trim() ?? "";
const hasHeroBg = heroBg !== "";
const noteLines = hero.note ?? [];

// ── 便签实时化：展示「动态」页最新一条（拉取失败回退上面的默认文案） ──
// 开关在 homeConfig.hero.noteLive；还要求动态页与 Twikoo 都启用
const noteTwikooReady =
	siteConfig.pages.moments &&
	commentConfig?.type === "twikoo" &&
	!!commentConfig.twikoo?.envId;
const noteLive = hero.noteLive !== false && noteTwikooReady;
const noteEnvId = commentConfig.twikoo?.envId ?? "";
const noteMasterNick = commentConfig.twikoo?.masterTag?.nickname ?? "";
const noteMasterEmail = (
	commentConfig.twikoo?.masterTag?.email ?? ""
).trim().toLowerCase();
// 邮箱摘要：自建 Twikoo 的 mailMd5 实测为 sha256，旧版为 md5，两种都比对；明文不进前端
const noteMailHashes = noteMasterEmail
	? [
			createHash("md5").update(noteMasterEmail).digest("hex"),
			createHash("sha256").update(noteMasterEmail).digest("hex"),
		].join(",")
	: "";
const polaroids = (hero.polaroids ?? []).slice(0, 2);
const quickLinks = cfg.quickLinks ?? [];
// target 以 # 开头 → 本页锚点（脚本平滑滚动）；否则按站内路径处理
const ctaHref = (t: string): string => (t.startsWith("#") ? t : url(t));
const windowImage = cfg.images.window?.trim() ?? "";
const hasWindowImage = windowImage !== "";

// ── 关于我：真实个人资料 + 公告 ──────────────────────────────────────────
const aboutLines =
	about.lines.length > 0
		? about.lines
		: [profileConfig.bio ?? ""].filter(Boolean);
const avatar = profileConfig.avatar ?? "";
const socialLinks = (profileConfig.links ?? []).filter((link) => link.url);

const notice = announcementConfig;
const noticeLink =
	notice.link && notice.link.enable !== false && notice.link.url
		? notice.link
		: null;

// ── 最新文章 ─────────────────────────────────────────────────────────────
const featured = posts.slice(
	0,
	Math.min(cfg.featuredCount, posts.length),
);
// 左侧一张主卡 + 右侧若干行小卡
const lead = featured[0];
const rest = featured.slice(1);

const hasCover = (image?: string): boolean =>
	!!image && image !== "api" && image.trim() !== "";

const coverBasePath = (id: string): string =>
	getFileDirFromPath(`src/content/posts/${id}`);

// 无封面时按分类 / 标题派生一个稳定的低饱和色相，避免灰块
function hueFromText(text: string): number {
	let h = 0;
	for (let i = 0; i < text.length; i++) {
		h = (h * 31 + text.charCodeAt(i)) % 360;
	}
	return h;
}

// ── 分类与入口 ───────────────────────────────────────────────────────────
// 「我在折腾」词条：配置驱动（homeConfig.exploreTags），
// 篇数按文章分类实时统计，计数为 0 的词条自动隐藏。
const categoryCounts = new Map(
	(await getCategoryList()).map((c) => [c.name, c.count]),
);
const exploreTags = cfg.exploreTags
	.map((tag) => ({ ...tag, count: categoryCounts.get(tag.category) ?? 0 }))
	.filter((tag) => tag.count > 0);

const allPosts = await getSortedPosts();
const totalPosts = allPosts.length;

// ── 全站总字数：去掉代码块与内联代码后，按中文字符 + 英文字母累计 ────────
let totalWords = 0;
for (const post of allPosts) {
	if (!post.body) continue;
	const text = post.body
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	totalWords +=
		(text.match(/[\u4e00-\u9fa5]/g)?.length ?? 0) +
		(text.match(/[a-zA-Z]/g)?.length ?? 0);
}
// 过万折成「N.N 万」，不足万按千位分隔展示
const totalWordsLabel =
	totalWords >= 10000
		? `${(totalWords / 10000).toFixed(1).replace(/\.0$/, "")} 万`
		: totalWords.toLocaleString();

const lastPost = allPosts[0];
const lastUpdate = lastPost
	? formatDateToYYYYMMDD(lastPost.data.published).replace(/-/g, ".")
	: "—";
const runningDays = Math.max(
	0,
	dayjs().diff(dayjs(siteConfig.siteStartDate), "day"),
);

const dateLabel = (date: Date): string =>
	formatDateToYYYYMMDD(date).replace(/-/g, ".");

const categoryOf = (entry: CollectionEntry<"posts">): string => {
	const c = entry.data.category;
	return c ? String(c).trim() : "";
};
---

<div class="fyh" id="fyh-home" data-fyh>
  {/* ══ 全页背景：雨夜窗前的山城灯火，整页固定不随滚动 ════════════════ */}
  <div class="fyh-pagebg" aria-hidden="true">
    {hasHeroBg && (
      <ImageWrapper
        class="fyh-pagebg__img"
        src={heroBg}
        alt=""
        position={hero.backgroundPosition ?? "center 58%"}
        loading="lazy"
        widths={[1280, 1920, 2560]}
        sizes="100vw"
      />
    )}
    <i class="fyh-pagebg__shade"></i>
  </div>
  {/* ══ 01 · 首屏：雨夜山城 ══════════════════════════════════════════ */}
  <section class="fyh-hero" data-fyh-hero aria-labelledby="fyh-hero-title">
    {/* 背景：雨夜窗前的山城灯火，滚动时以更慢的速度掠过（视差） */}
    <div class="fyh-hero__bg" aria-hidden="true">
      <div class="fyh-hero__bg-move" data-hero-bg>
        {hasHeroBg && (
          <ImageWrapper
            class="fyh-hero__bg-img"
            src={heroBg}
            alt=""
            position={hero.backgroundPosition ?? "center 58%"}
            loading="eager"
            fetchpriority="high"
            widths={[1280, 1920, 2560]}
            sizes="100vw"
          />
        )}
      </div>
      {/* 压暗 + 底部过渡：上端保证导航可读，底端融进下一段的夜幕 */}
      <i class="fyh-hero__shade" aria-hidden="true"></i>
    </div>

    <div class="fyh-hero__inner">
      <div class="fyh-hero__text">
        <p class="fyh-eyebrow">
          {hero.eyebrow}
          <i class="fyh-eyebrow__line" aria-hidden="true"></i>
        </p>
        <h1 id="fyh-hero-title" class="fyh-hero__title">
          {hero.titleLines.map((line) => (
            <span class="fyh-hero__line">
              <span class="fyh-hero__line-in">{line}</span>
            </span>
          ))}
        </h1>
        <p class="fyh-hero__sub">{hero.subtitle}</p>

        <div class="fyh-hero__cta fyh-extra">
          {hero.primaryCta && (
            <a class="fyh-btn" href={ctaHref(hero.primaryCta.target)} data-scroll-to>
              {hero.primaryCta.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12h15" /><path d="M13 6l6 6-6 6" />
              </svg>
            </a>
          )}
          {hero.secondaryCta && (
            <a class="fyh-plainlink" href={ctaHref(hero.secondaryCta.target)} data-scroll-to>
              {hero.secondaryCta.label}
            </a>
          )}
        </div>
      </div>

      <figure class="fyh-hero__side" data-hero-side>
        <div class="fyh-hero__win" data-fyh-hero-win>
          <div class="fyh-hero__arch">
            {hasHeroImage ? (
              <ImageWrapper
                class="fyh-hero__media"
                src={heroImage}
                alt={hero.imageAlt}
                position={hero.imagePosition}
                loading="eager"
                fetchpriority="high"
                widths={[480, 720, 960]}
                sizes="(min-width: 900px) 24vw, 60vw"
              />
            ) : (
              <div class="fyh-win-blank" aria-hidden="true">
                <span>YSDY</span>
              </div>
            )}
            <i class="fyh-hero__sheen" aria-hidden="true"></i>
          </div>
        </div>

        {noteLines.length > 0 && (
          <span class="fyh-hero__note fyh-extra" aria-hidden="true">
            <i
              class="fyh-hero__note-paper"
              data-live={noteLive ? "true" : undefined}
              data-env-id={noteLive ? noteEnvId : undefined}
              data-master-nick={noteLive ? noteMasterNick : undefined}
              data-mail-hashes={noteLive ? noteMailHashes : undefined}
              data-moments-url={url("/moments/")}
            >
              {noteLines.map((line) => <span>{line}</span>)}
            </i>
          </span>
        )}

        {polaroids[0] && (
          <span class="fyh-hero__polaroid fyh-hero__polaroid--a fyh-extra" aria-hidden="true">
            <i class="fyh-hero__polaroid-frame">
              <ImageWrapper
                class="fyh-hero__polaroid-img"
                src={polaroids[0].image}
                alt=""
                position={polaroids[0].position}
                loading="lazy"
                widths={[160, 320]}
                sizes="110px"
              />
            </i>
          </span>
        )}
        {polaroids[1] && (
          <span class="fyh-hero__polaroid fyh-hero__polaroid--b fyh-extra" aria-hidden="true">
            <i class="fyh-hero__polaroid-frame">
              <ImageWrapper
                class="fyh-hero__polaroid-img"
                src={polaroids[1].image}
                alt=""
                position={polaroids[1].position}
                loading="lazy"
                widths={[160, 320]}
                sizes="84px"
              />
            </i>
          </span>
        )}

        {hero.windowCaption && (
          <figcaption class="fyh-hero__winlabel fyh-extra" aria-hidden="true">
            {hero.windowCaption}
          </figcaption>
        )}
      </figure>
    </div>

    {/* 首屏底部：三张快捷卡片 */}
    {quickLinks.length > 0 && (
      <nav class="fyh-quick" aria-label="首页快捷入口">
        {quickLinks.map((q) => (
          <a class="fyh-quick__card fyh-extra" href={q.target ? ctaHref(q.target) : url(q.url ?? "/")}>
            <span class="fyh-quick__thumb">
              {q.image && (
                <ImageWrapper
                  class="fyh-quick__img"
                  src={q.image}
                  alt=""
                  position="center 55%"
                  loading="lazy"
                  widths={[160, 320]}
                  sizes="80px"
                />
              )}
            </span>
            <span class="fyh-quick__body">
              <b>
                {q.title}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12h15" /><path d="M13 6l6 6-6 6" />
                </svg>
              </b>
              <small>{q.desc}</small>
            </span>
          </a>
        ))}
      </nav>
    )}

    <div class="fyh-hero__scroll fyh-mono" aria-hidden="true">
      <span class="fyh-hero__mouse"><i></i></span>
      <span class="fyh-hero__scroll-label">
        <i></i>{hero.scrollLabel}<i></i>
      </span>
    </div>
  </section>

  <p class="fyh-bridge" aria-hidden="true">{cfg.bridges.toAbout}</p>

  {/* ══ 02 · 关于我 ══════════════════════════════════════════════════ */}
  <section class="fyh-about" id="fyh-about" data-fyh-about aria-labelledby="fyh-about-title">
    <div class="fyh-about__body">
      <h2 id="fyh-about-title" class="fyh-h2">{about.title}</h2>

      <div class="fyh-about__lines">
        {aboutLines.map((line) => <p data-fyh-rise>{line}</p>)}
      </div>

      <div class="fyh-identity" data-fyh-rise>
        <div class="fyh-identity__avatar">
          {avatar && (
            <ImageWrapper
              src={avatar}
              alt={profileConfig.name}
              loading="lazy"
              widths={[96, 160]}
              sizes="56px"
            />
          )}
        </div>
        <div class="fyh-identity__meta">
          <p class="fyh-identity__name">{profileConfig.name}</p>
          {profileConfig.bio && (
            <p class="fyh-identity__bio">{profileConfig.bio}</p>
          )}
          {socialLinks.length > 0 && (
            <ul class="fyh-identity__links">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target={link.url.startsWith("http") ? "_blank" : "_self"}
                    rel={link.url.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined}
                    aria-label={link.name}
                  >
                    <Icon name={link.icon} />
                    {link.showName && <span>{link.name}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <aside class="fyh-notice" data-fyh-rise>
        <p class="fyh-notice__label fyh-mono">{about.noticeLabel}</p>
        <p class="fyh-notice__text">{notice.content}</p>
        {noticeLink && (
          <a
            class="fyh-notice__link"
            href={noticeLink.url}
            target={noticeLink.external ? "_blank" : "_self"}
            rel={noticeLink.external ? "noopener noreferrer" : undefined}
          >
            {noticeLink.text}
          </a>
        )}
      </aside>
    </div>

    <div class="fyh-about__media">
      <div class="fyh-about__win" data-fyh-about-win>
        {hasWindowImage && (
          <ImageWrapper
            class="fyh-about__media-img"
            src={windowImage}
            alt=""
            position="center 45%"
            loading="lazy"
            widths={[640, 960, 1440]}
            sizes="(min-width: 1024px) 44vw, 92vw"
          />
        )}
        <canvas
          class="fyh-about__glass"
          data-fyh-glass
          aria-hidden="true"
        ></canvas>
      </div>
      <p class="fyh-caption fyh-mono">
        <span class="fyh-caption__line" aria-hidden="true"></span>
        {about.caption}
      </p>
    </div>
  </section>

  <p class="fyh-bridge" aria-hidden="true">{cfg.bridges.toArticles}</p>

  {/* ══ 03 · 最新文章 ════════════════════════════════════════════════ */}
  <section
    class="fyh-articles"
    id="fyh-latest"
    data-fyh-articles
    aria-labelledby="fyh-articles-title"
  >
    <header class="fyh-head-row">
      <div>
        <h2 id="fyh-articles-title" class="fyh-h2">
          <span class="fyh-mask"><span class="fyh-mask__in">{articles.title}</span></span>
        </h2>
        <p class="fyh-head-desc">{articles.description}</p>
      </div>
      <a class="fyh-more" href={articles.archiveUrl}>
        {articles.moreLabel}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12h15" /><path d="M13 6l6 6-6 6" />
        </svg>
      </a>
    </header>

    {/* 主卡 + 行卡：左 1 张大图，右侧其余文章列表 */}
    <div class="fyh-latest">
      {lead && (
        <a
          class="fyh-lead"
          href={getPostUrlBySlug(lead.id)}
          aria-label={`${lead.data.title} · ${dateLabel(lead.data.published)}`}
        >
          <div class="fyh-lead__frame">
            {hasCover(lead.data.image) ? (
              <ImageWrapper
                class="fyh-lead__cover"
                src={lead.data.image}
                alt=""
                basePath={coverBasePath(lead.id)}
                loading="lazy"
                widths={[720, 960, 1440]}
                sizes="(min-width: 900px) 56vw, 92vw"
              />
            ) : (
              <div
                class="fyh-lead__fallback"
                style={`--fyh-hue:${hueFromText(categoryOf(lead) || lead.data.title)};`}
                aria-hidden="true"
              >
                <span>{categoryOf(lead) || lead.data.title}</span>
              </div>
            )}
            <div class="fyh-lead__band">
              <p class="fyh-lead__date fyh-mono">
                {dateLabel(lead.data.published)}
              </p>
              <h3 class="fyh-lead__title">{lead.data.title}</h3>
              {categoryOf(lead) && (
                <p class="fyh-lead__cat">
                  <i aria-hidden="true"></i>
                  {categoryOf(lead)}
                </p>
              )}
            </div>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <ul class="fyh-side">
          {rest.map((entry) => {
            const cover = entry.data.image;
            const category = categoryOf(entry);
            return (
              <li>
                <a
                  class="fyh-side__row"
                  href={getPostUrlBySlug(entry.id)}
                >
                  <span class="fyh-side__thumb">
                    {hasCover(cover) ? (
                      <ImageWrapper
                        class="fyh-side__img"
                        src={cover}
                        alt=""
                        basePath={coverBasePath(entry.id)}
                        loading="lazy"
                        widths={[320, 480]}
                        sizes="(min-width: 900px) 15vw, 36vw"
                      />
                    ) : (
                      <div
                        class="fyh-side__fallback"
                        style={`--fyh-hue:${hueFromText(category || entry.data.title)};`}
                        aria-hidden="true"
                      ></div>
                    )}
                  </span>
                  <span class="fyh-side__body">
                    <time class="fyh-mono">{dateLabel(entry.data.published)}</time>
                    <b>{entry.data.title}</b>
                    {category && <em>{category}</em>}
                  </span>
                  <svg class="fyh-side__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12h15" /><path d="M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </section>

  <p class="fyh-bridge" aria-hidden="true">{cfg.bridges.toEntries}</p>

  {/* ══ 04 · 分类与入口 ══════════════════════════════════════════════ */}
  <section
    class="fyh-entries"
    data-fyh-entries
    aria-labelledby="fyh-entries-title"
  >
    <header class="fyh-head-row">
      <h2 id="fyh-entries-title" class="fyh-h2">{entries.title}</h2>
      <span class="fyh-note-inline fyh-mono">{entries.note}</span>
    </header>

    {/* 夜航站牌：每个去处一行，翻牌入场；悬停底色由滑动高亮层统一负责 */}
    <div class="fyh-board-wrap">
      <span class="fyh-board__hl" aria-hidden="true"></span>
      <div class="fyh-board" role="list">
        {cfg.departures.map((dep, i) => (
          <a
            class="fyh-board__row"
            data-fyh-tile
            role="listitem"
            href={dep.url}
          >
            <span class="fyh-board__no fyh-mono" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="fyh-board__main">
              <span class="fyh-board__name">{dep.name}</span>
              <span class="fyh-board__desc">{dep.desc}</span>
            </span>
            <span class="fyh-board__leader" aria-hidden="true"></span>
            <span class="fyh-board__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12h15" /><path d="M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="fyh-pills" data-fyh-rise>
      {exploreTags.map((tag) => (
        <a class="fyh-pill" href={getCategoryUrl(tag.category)}>
          <Icon name={tag.icon} class="fyh-pill__icon" aria-hidden="true" />
          <span class="fyh-pill__name">{tag.name}</span>
          <span class="fyh-pill__desc">{tag.desc}</span>
          <i class="fyh-mono">×{tag.count}</i>
        </a>
      ))}
    </div>

    <div class="fyh-stats fyh-mono" data-fyh-rise>
      <span>文章<b>{totalPosts}</b></span>
      <span>总字数<b>{totalWordsLabel}</b></span>
      <span>运行<b>{runningDays} 天</b></span>
      <span>最近更新<b>{lastUpdate}</b></span>
      <a href="/rss.xml">订阅<b>RSS</b></a>
    </div>
  </section>
</div>

<script>
  import { initHomeCinematic } from "@/utils/home-cinematic";

  initHomeCinematic();
</script>

<script>
  // 首屏视差与锚点平滑滚动。
  // 仅动 transform，不碰布局；reduced-motion 时完全静止。
  // Swup 换页后由 astro:page-load 重新绑定，旧的滚动监听先解除。
  function bindHomeHero() {
    const win = window as Window & { __fyhHeroClean?: () => void };
    win.__fyhHeroClean?.();
    const root = document.getElementById("fyh-home");
    if (!root) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const hero = root.querySelector<HTMLElement>("[data-fyh-hero]");
    const bg = root.querySelector<HTMLElement>("[data-hero-bg]");
    const side = root.querySelector<HTMLElement>("[data-hero-side]");

    const controller = new AbortController();
    win.__fyhHeroClean = () => controller.abort();

    if (!reduce && hero && bg) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY;
        if (y <= hero.offsetHeight) {
          bg.style.transform = `translate3d(0, ${(y * 0.14).toFixed(1)}px, 0)`;
          if (side) {
            side.style.transform = `translate3d(0, ${(y * 0.06).toFixed(1)}px, 0)`;
          }
        }
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true, signal: controller.signal },
      );
      update();
    }

    if (!reduce) {
      // 自实现的平滑滚动：内嵌 webview 可能禁用原生的 behavior:"smooth"
      const smoothScrollTo = (target: HTMLElement) => {
        const start = window.scrollY;
        const end =
          start + target.getBoundingClientRect().top - 76;
        const dist = end - start;
        if (Math.abs(dist) < 2) return;
        const dur = Math.min(1100, Math.max(500, Math.abs(dist) * 0.32));
        const t0 = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          window.scrollTo(0, start + dist * ease(p));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      root.addEventListener("click", (e) => {
        const anchor = (e.target as HTMLElement | null)?.closest(
          'a[href^="#fyh-"]',
        );
        if (!anchor) return;
        const target = document.getElementById(
          anchor.getAttribute("href")!.slice(1),
        );
        if (!target) return;
        e.preventDefault();
        smoothScrollTo(target);
      }, { signal: controller.signal });
    }
  }

  const w = window as Window & { __fyhHeroBound?: boolean };
  if (!w.__fyhHeroBound) {
    w.__fyhHeroBound = true;
    document.addEventListener("astro:page-load", bindHomeHero);
  }
  bindHomeHero();

  // ── 分类与入口·夜航站牌：滑动高亮层 ────────────────────────────────
  // 与归档页同一套 magic highlight：整条列表只有一个高亮背景，
  // 鼠标从 01 往返划到 05 时在行间平滑流动，而不是逐行硬切。
  function bindBoardHighlight() {
    const win = window as Window & { __fyhBoardClean?: () => void };
    win.__fyhBoardClean?.();

    const wrap = document.querySelector<HTMLElement>(".fyh-board-wrap");
    const hl = wrap?.querySelector<HTMLElement>(".fyh-board__hl");
    if (!wrap || !hl) return;
    // 仅 hover 设备启用（触屏没有 mouseover 流）
    if (!window.matchMedia("(hover: hover)").matches) return;

    const move = (e: MouseEvent) => {
      const row = (e.target as HTMLElement | null)?.closest?.(
        ".fyh-board__row",
      ) as HTMLElement | null;
      if (!row || !wrap.contains(row)) return;
      // 相对容器坐标：页面滚动时两边矩形同步偏移，差值恒定，无需监听滚动
      const rowRect = row.getBoundingClientRect();
      const baseRect = wrap.getBoundingClientRect();
      hl.style.transform = `translateY(${(rowRect.top - baseRect.top).toFixed(1)}px)`;
      hl.style.height = `${rowRect.height}px`;
      hl.classList.add("is-visible");
    };
    const hide = () => hl.classList.remove("is-visible");

    wrap.addEventListener("mouseover", move);
    wrap.addEventListener("mouseleave", hide);
    win.__fyhBoardClean = () => {
      wrap.removeEventListener("mouseover", move);
      wrap.removeEventListener("mouseleave", hide);
    };
  }

  const wb = window as Window & { __fyhBoardBound?: boolean };
  if (!wb.__fyhBoardBound) {
    wb.__fyhBoardBound = true;
    document.addEventListener("astro:page-load", bindBoardHighlight);
  }
  bindBoardHighlight();
</script>

<script>
  // 便签实时化：拉取「动态」页最新一条博主动态，替换手写便签的文案。
  // 模块脚本整个文档只执行一次：首次进首页靠立即调用，swup 回到首页时
  // 便签 DOM 已被缓存 HTML 重建，由 astro:page-load 再拉一次。拉取失败
  // 静默保留 SSR 的默认文案。
  import { fetchLatestMoment } from "@/utils/twikoo-moments";
  import { getSwup } from "@/utils/swup-lifecycle";

  function bindNoteMoment() {
    const paper = document.querySelector<HTMLElement>(
      "#fyh-home .fyh-hero__note-paper",
    );
    if (!paper || paper.dataset.live !== "true") return;
    const envId = paper.dataset.envId ?? "";
    const masterNick = paper.dataset.masterNick ?? "";
    const mailHashes = (paper.dataset.mailHashes ?? "")
      .split(",")
      .filter(Boolean);
    if (!envId || !masterNick) return;

    // 点击便签跳转动态页（有 swup 走平滑切换，否则直接跳）
    const momentsUrl = paper.dataset.momentsUrl || "/moments/";
    paper.addEventListener("click", () => {
      const swup = getSwup();
      if (swup?.navigate) swup.navigate(momentsUrl);
      else window.location.href = momentsUrl;
    });

    fetchLatestMoment({ envId, author: { masterNick, mailHashes } })
      .then((m) => {
        // 请求期间可能已换页离开首页，便签不再连着文档就放弃
        if (!m || !paper.isConnected) return;
        // 便签很窄：约 7 字一行、最多 4 行，第一行留给心情 emoji；
        // 截断时省略号要占掉末行一个字位，保证它不会被行数上限挤掉
        const perLine = 7;
        const maxLines = 4;
        const availLines = m.mood ? maxLines - 1 : maxLines;
        const maxChars = availLines * perLine;
        const body =
          m.text.length > maxChars
            ? `${m.text.slice(0, maxChars - 1)}…`
            : m.text;
        const lines: string[] = [];
        if (m.mood) lines.push(m.mood);
        for (
          let i = 0;
          i < body.length && lines.length < maxLines;
          i += perLine
        ) {
          lines.push(body.slice(i, i + perLine));
        }
        if (lines.length === 0) return;
        paper.replaceChildren(
          ...lines.map((t) => {
            const s = document.createElement("span");
            s.textContent = t;
            return s;
          }),
        );
        paper.closest(".fyh-hero__note")?.classList.add("fyh-note-live");
      })
      .catch(() => {
        /* Twikoo 不可达时保留默认文案 */
      });
  }

  const noteWin = window as Window & { __fyhNoteBound?: boolean };
  if (!noteWin.__fyhNoteBound) {
    noteWin.__fyhNoteBound = true;
    document.addEventListener("astro:page-load", bindNoteMoment);
  }
  bindNoteMoment();
</script>

