---
import { Icon } from "astro-icon/components";
import { LinkPresets } from "@/constants/link-presets";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

// 处理links中的LinkPreset转换
const processedLinks = Astro.props.links.map((link: NavBarLink) => ({
	...link,
	children: link.children?.map((child: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof child === "number") {
			return LinkPresets[child];
		}
		return child;
	}),
}));

// 构建期计算激活态（Swup 切换后会由 Navbar 的 updateNavActive 再次刷新）
const normalizePath = (p: string): string => {
	const clean = p.split("?")[0].split("#")[0].replace(/\/+$/, "");
	return clean === "" ? "/" : clean;
};
const currentPath = normalizePath(Astro.url.pathname);
const isLinkActive = (link: NavBarLink): boolean => {
	if (link.external) return false;
	const href = url(link.url);
	const children = (link.children || [])
		.filter((c): c is NavBarLink => typeof c !== "number" && !c.external)
		.map((c) => url(c.url));
	return (
		currentPath === normalizePath(href) ||
		children.map(normalizePath).includes(currentPath)
	);
};
const navHrefAttr = (link: NavBarLink): string | undefined =>
	link.external ? undefined : url(link.url);
const navChildrenAttr = (link: NavBarLink): string | undefined => {
	const children = (link.children || [])
		.filter((c): c is NavBarLink => typeof c !== "number" && !c.external)
		.map((c) => url(c.url));
	return children.length > 0 ? children.map(normalizePath).join(" ") : undefined;
};
const indexLabel = (i: number): string => String(i + 1).padStart(2, "0");
---

{/* 全屏夜幕菜单：整屏压暗 + 大号衬线菜单逐行浮现（样式在 navbar.css） */}
<div id="nav-menu-panel" class="float-panel float-panel-closed">
    <div class="nm-inner">
        <p class="nm-eyebrow nm-rise">Navigation</p>
        <nav class="nm-list" aria-label="站内导航">
            {processedLinks.map((link, i) => (
                <div class="nm-rise mobile-menu-item">
                    {link.children && link.children.length > 0 ? (
                        <div class="mobile-dropdown" data-mobile-dropdown>
                            <button
                                class:list={["nm-item", isLinkActive(link) && "nav-active"]}
                                data-mobile-dropdown-trigger
                                data-nav-href={navHrefAttr(link)}
                                data-nav-children={navChildrenAttr(link)}
                                aria-expanded="false"
                            >
                                <span class="nm-item__index">{indexLabel(i)}</span>
                                <span class="nm-item__name">{link.name}</span>
                                <Icon name="material-symbols:keyboard-arrow-down-rounded" is:inline
                                      class="mobile-dropdown-arrow transition-transform duration-200 text-[1.25rem]"
                                />
                            </button>
                            <div class="nm-submenu" data-mobile-submenu>
                                {link.children.map((child) => (
                                    <a href={child.external ? child.url : url(child.url)}
                                       class="nm-subitem"
                                       target={child.external ? "_blank" : null}
                                    >
                                        {child.icon && <Icon name={child.icon} is:inline class="text-[1.05rem]" />}
                                        <span>{child.name}</span>
                                        {child.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline
                                              class="text-[0.75rem] opacity-50"
                                        />}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a href={link.external ? link.url : url(link.url)}
                           class:list={["nm-item", isLinkActive(link) && "nav-active"]}
                           target={link.external ? "_blank" : null}
                           data-nav-href={navHrefAttr(link)}
                           data-nav-children={navChildrenAttr(link)}
                        >
                            <span class="nm-item__index">{indexLabel(i)}</span>
                            <span class="nm-item__name">{link.name}</span>
                            {link.external && <Icon name="fa7-solid:arrow-up-right-from-square" is:inline
                                  class="text-[0.8rem] opacity-50"
                            />}
                        </a>
                    )}
                </div>
            ))}
        </nav>
        <p class="nm-foot nm-rise">YSDY · PERSONAL BLOG</p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const panel = document.getElementById('nav-menu-panel');
        if (!panel) return;

        const mobileDropdowns = panel.querySelectorAll('[data-mobile-dropdown]');

        mobileDropdowns.forEach(dropdown => {
            const trigger = dropdown.querySelector('[data-mobile-dropdown-trigger]');
            if (!trigger) return;

            trigger.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const isExpanded = dropdown.getAttribute('data-expanded') === 'true';

                // 关闭其他打开的下拉菜单
                mobileDropdowns.forEach(otherDropdown => {
                    if (otherDropdown !== dropdown) {
                        otherDropdown.setAttribute('data-expanded', 'false');
                        const otherTrigger = otherDropdown.querySelector('[data-mobile-dropdown-trigger]');
                        if (otherTrigger) {
                            otherTrigger.setAttribute('aria-expanded', 'false');
                        }
                    }
                });

                // 切换当前下拉菜单
                const newState = !isExpanded;
                dropdown.setAttribute('data-expanded', newState.toString());
                trigger.setAttribute('aria-expanded', newState.toString());
            });
        });

        // 关闭菜单：点空白处或点任意导航链接（链接由 Swup 接管跳转）
        const menuPanel = panel;
        function closePanel() {
            menuPanel.classList.add('float-panel-closed');
            document.body.style.overflow = '';
        }

        panel.addEventListener('click', function(e) {
            const target = e.target instanceof Element ? e.target : null;
            if (target && target.closest('a, [data-mobile-dropdown-trigger]')) return;
            closePanel();
        });

        panel.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', closePanel);
        });
    });
</script>
