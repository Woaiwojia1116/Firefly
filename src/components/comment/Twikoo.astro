---
import { commentConfig } from "@/config/commentConfig";
import { url } from "@/utils/url-utils";

interface Props {
	path: string;
}
---

<div id="tcomment"></div>
<!-- 使用自编译的 Twikoo 文件，避免点赞等按钮导致页面触发滚动回顶部 https://github.com/twikoojs/twikoo/issues/721 -->
<script is:inline src={url("/assets/js/twikoo.nocss.js")}></script>
<link rel="stylesheet" href={url("/assets/css/twikoo.css")} />
<link rel="stylesheet" href={url("/assets/css/twikoo-custom.css")} />
<script is:inline define:vars={{ masterTag: commentConfig.twikoo?.masterTag }}>
  // 获取当前页面路径
  function getCurrentPath() {
    const pathname = window.location.pathname;
    return pathname.endsWith("/") && pathname.length > 1
      ? pathname.slice(0, -1)
      : pathname;
  }

  // 动态创建配置对象
  function createTwikooConfig() {
    return {
      envId: "https://twokoo.ccwu.cc",
      lang: "zh-CN",
      visitorCount: false,
      path: getCurrentPath(),
      el: "#tcomment",
    };
  }

  // 初始化 Twikoo
  function initTwikoo() {
    if (typeof twikoo !== "undefined") {
      const commentEl = document.getElementById("tcomment");
      if (commentEl) {
        const dynamicConfig = createTwikooConfig();

        twikoo
          .init(dynamicConfig)
          .then(() => {
            // 兜底：初始渲染可能用 innerHTML 批量写入，observer 补标签
            observeComments();
          })
          .catch((error) => {
            console.error("[Twikoo] 初始化失败:", error);
          });
      }
    } else {
      // 如果 Twikoo 未加载，稍后重试
      setTimeout(initTwikoo, 500);
    }
  }

  // 评论框占位语：前端固定覆盖，不依赖 Twikoo 后台的 PLACEHOLDER 配置。
  // 想换文案改这一行即可；删掉 applyPlaceholder 的调用则交还给后台配置。
  const FF_COMMENT_PLACEHOLDER = "说什么好呢୧(๑•̀⌄•́๑)૭";

  function applyPlaceholder() {
    const area = document.querySelector(".tk-input .el-textarea__inner");
    if (area && area.placeholder !== FF_COMMENT_PLACEHOLDER) {
      area.placeholder = FF_COMMENT_PLACEHOLDER;
    }
  }

  // 把评论数并入外壳眉标：COMMENTS · N（Twikoo 自带的「N 条评论」由 CSS 隐藏）
  // 注意：Twikoo 的 Vue 实例挂载时会替换掉 #tcomment 元素，
  // 所有选择器都要从渲染出来的 .twikoo 根上找，不能依赖 #tcomment。
  function syncEyebrowCount() {
    const eyebrow = document.querySelector(".ip-comments-eyebrow-count");
    const count = document.querySelector(".tk-comments-count > span:first-child");
    if (!eyebrow || !count) return;
    const n = count.textContent.trim();
    if (!n || eyebrow.textContent === `· ${n}`) return;
    eyebrow.textContent = `· ${n}`;
    eyebrow.hidden = false;
  }

  // ── 萤火：点击发送后，若列表里真的多出一条评论，就从按钮飘起一点暖光 ──
  let fireflyArmedUntil = 0;
  let fireflyBaseline = 0;

  function armFirefly() {
    fireflyArmedUntil = Date.now() + 12000;
    fireflyBaseline = document.querySelectorAll(".tk-comment").length;
  }

  function spawnFirefly() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (document.querySelector(".ff-firefly")) return; // 一次只飘一点
    const btn = document.querySelector(".tk-send");
    if (!btn) return;
    const rect = btn.getBoundingClientRect();
    const dot = document.createElement("span");
    dot.className = "ff-firefly";
    dot.style.left = `${rect.left + rect.width / 2}px`;
    dot.style.top = `${rect.top + rect.height / 2}px`;
    document.body.appendChild(dot);
    dot.addEventListener("animationend", () => dot.remove());
  }

  function maybeCelebrate() {
    if (Date.now() > fireflyArmedUntil) return;
    if (document.querySelectorAll(".tk-comment").length <= fireflyBaseline) return;
    fireflyArmedUntil = 0;
    spawnFirefly();
  }

  document.addEventListener(
    "click",
    function (event) {
      if (event.target instanceof Element && event.target.closest(".tk-send")) {
        armFirefly();
      }
    },
    true
  );

  function addTagToComment(comment) {
    if (!masterTag || !masterTag.label) return;
    if (comment.querySelector(".firefly-master-tag")) return;

    let isMaster = false;

    if (masterTag.nickname) {
      const nickEl = comment.querySelector(".tk-nick-link") || comment.querySelector(".tk-nick");
      if (nickEl && nickEl.textContent.trim() === masterTag.nickname) {
        isMaster = true;
      }
    }

    if (!isMaster && masterTag.email) {
      const emailEl = comment.querySelector(".tk-email");
      if (emailEl && emailEl.textContent.trim().toLowerCase() === masterTag.email.toLowerCase()) {
        isMaster = true;
      }
    }

    if (!isMaster) return;

    const nickEl = comment.querySelector(".tk-nick-link") || comment.querySelector(".tk-nick");
    if (!nickEl) return;

    const tag = document.createElement("span");
    tag.className = "firefly-master-tag";
    tag.textContent = masterTag.label;
    tag.style.cssText = `
      display: inline-block;
      margin-left: 6px;
      padding: 1px 8px;
      font-size: 11px;
      font-weight: 500;
      line-height: 1.5;
      border-radius: 999px;
      letter-spacing: 0.04em;
      background-color: ${masterTag.bgColor || "#ff6b6b"};
      color: ${masterTag.textColor || "#fff"};
      vertical-align: middle;
      white-space: nowrap;
    `;

    nickEl.parentNode?.insertBefore(tag, nickEl.nextSibling);
  }

  // 给博主评论添加标签（批量，用于 observer 回调）
  function applyMasterTag() {
    const comments = document.querySelectorAll(".tk-comment:not(.firefly-master-tag)");
    comments.forEach(addTagToComment);
  }

  // 监听评论加载完成（Twikoo 异步渲染评论）。
  // 观察点必须挂在 Vue 渲染出来的 .twikoo 根元素上：#tcomment 在挂载时
  // 会被整个替换掉，挂上去的 observer 和 DOM 拦截都会随它一起失效。
  function observeComments() {
    const target = document.querySelector(".twikoo");

    if (!target) {
      // init 的 promise resolve 时组件可能尚未渲染完成，稍后重试
      setTimeout(observeComments, 400);
      return;
    }

    applyMasterTag();
    syncEyebrowCount();
    applyPlaceholder();

    // 用 rAF 合并同帧内的多次 DOM 变更
    let rafId = null;
    const scheduleApply = () => {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(() => {
        rafId = null;
        applyMasterTag();
        syncEyebrowCount();
        applyPlaceholder();
        maybeCelebrate();
      });
    };

    const observer = new MutationObserver(scheduleApply);
    observer.observe(target, { childList: true, subtree: true });
  }

  // 页面加载时初始化
  document.addEventListener("DOMContentLoaded", () => {
    initTwikoo();
  });

  // Swup 页面切换后重新初始化
  if (window.swup && window.swup.hooks) {
    window.swup.hooks.on("content:replace", function () {
      setTimeout(() => {
        initTwikoo();
      }, 200);
    });
  } else {
    document.addEventListener("swup:enable", function () {
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("content:replace", function () {
          setTimeout(() => {
            initTwikoo();
          }, 200);
        });
      }
    });
  }

  // 自定义事件监听
  document.addEventListener("firefly:page:loaded", function () {
    const commentEl = document.getElementById("tcomment");
    if (commentEl) {
      console.log("[Twikoo] 通过自定义事件重新初始化");
      initTwikoo();
    }
  });
</script>
