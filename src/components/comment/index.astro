---
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config/commentConfig";
import Key from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { removeFileExtension } from "@/utils/url-utils";
import Artalk from "./Artalk.astro";
import Disqus from "./Disqus.astro";
import Giscus from "./Giscus.astro";
import Twikoo from "./Twikoo.astro";
import Waline from "./Waline.astro";

interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
}

const { post, customPath, title: customTitle } = Astro.props as Props;

// 根据页面类型确定路径
const slugFromPath = (customPath || "/").replace(/^\/+|\/+$/g, "") || "index";
const slug = post ? removeFileExtension(post.id) : slugFromPath;
const path = customPath
	? customPath
	: post
		? post.collection === "posts"
			? `/posts/${slug}`
			: `/${slug}`
		: `/${slug}`;
const url = `${Astro.site?.href}${path}`;
const postTitle = post && "title" in post.data ? post.data.title : undefined;

// 强制commentService类型为string，避免类型不兼容警告
let commentService: string = commentConfig?.type || "none";
---

{
  commentService !== "none" && (
    <section id="post-comments" class="ip-comments">
      <header class="ip-comments-head">
        <p class="ip-eyebrow ip-comments-eyebrow">
          <span class="fy-dot fy-dot--lit" aria-hidden="true" />
          <span class="ip-comments-eyebrow-text">Comments</span>
          <span class="ip-comments-eyebrow-count" hidden />
        </p>
        <h2 class="ip-comments-title">{i18n(Key.commentSection)}</h2>
      </header>
      <div class="ip-comments-body">
        {commentService === "twikoo" && <Twikoo path={path} />}
        {commentService === "waline" && <Waline path={path} />}
        {commentService === "giscus" && <Giscus />}
        {commentService === "disqus" && (
          <Disqus identifier={slug} url={url} title={customTitle || postTitle || slug} />
        )}
        {commentService === "artalk" && <Artalk path={path} />}
        {commentService === "none" && (
          <div class="ip-comments-empty">{i18n(Key.commentNotConfigured)}</div>
        )}
      </div>
    </section>
  )
}

<style>
  /* 评论区 = 文章的最后一节：直接坐在纸面上，以细线起头，不再是玻璃卡片 */
  .ip-comments {
    margin-block: 1.75rem 2rem;
    padding-top: 1.9rem;
    border-top: 1px solid var(--ip-line-soft);
  }

  .ip-comments-head {
    margin-bottom: 1.6rem;
  }

  /* 眉标：等宽小字 + 萤火点；评论数由 Twikoo 加载后并入（COMMENTS · N） */
  .ip-comments-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.85rem;
  }

  .ip-comments-eyebrow-count {
    letter-spacing: 0.14em;
  }

  /* 标题与文章标题（.ip-post-title）同一比例，缩一档 */
  .ip-comments-title {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ip-ink);
  }

  .ip-comments-body {
    margin-top: 1.5rem;
  }

  .ip-comments-empty {
    padding: 2.5rem 0;
    text-align: center;
    font-size: 0.88rem;
    color: var(--ip-ink-faint);
  }
</style>
